\description{
Registers an \strong{observed phenotype}: the quantity written to \code{ind_phenotype}
when \code{\link[=add_phenotype]{add_phenotype()}} is called. For simple (non-composite) traits,
\code{phenotype_name} equals \code{trait_name} and \code{\link[=define_trait]{define_trait()}} must already have
been called for that name. For composite traits (e.g. weaning weight
assembled from direct and maternal components), no \code{\link[=define_trait]{define_trait()}} call is
needed for the composite name itself.

Writes one row to \code{phenotype_meta}. If \code{residual_var} is supplied, also
writes an unconditional diagonal entry to \code{phenotype_var_comp}
(\code{effect_name = "residual"}). If \code{components} is supplied, writes one row
per component to \code{phenotype_components}.
}
\examples{
\dontrun{
# ── Simple continuous trait ──────────────────────────────────────────────
pop <- pop |>
  define_trait("ADG") |>
  get_table("genome_meta") |>
  define_additive_effects("ADG", G = 100) |>
  define_phenotype("ADG",
    type         = "continuous",
    mean         = 850,
    residual_var = 120)

# ── Count trait with clipping bounds ────────────────────────────────────
pop <- pop |>
  define_trait("NW") |>
  get_table("genome_meta") |>
  define_additive_effects("NW", G = 2) |>
  define_phenotype("NW",
    type         = "count",
    mean         = 10,
    min_value    = 1,
    max_value    = 30,
    residual_var = 8)

# ── Categorical trait (binary via prevalence) ────────────────────────────
pop <- pop |>
  define_trait("mort") |>
  get_table("genome_meta") |>
  define_additive_effects("mort", G = 0.05) |>
  define_phenotype("mort",
    type       = "categorical",
    prevalence = 0.05,
    cat_names  = c("Alive", "Dead"))

# ── Maternal composite via components data frame: WW = WWD (self) + WWM (dam) ──
pop <- pop |>
  define_phenotype("WW",
    type         = "continuous",
    mean         = 230,
    residual_var = 180,
    components   = tibble::tribble(
      ~source_trait_name, ~contributor_type,
      "WWD",              "self",
      "WWM",              "dam"
    ))

# ── Maternal composite via formula_tbv shorthand (equivalent to above) ──
pop <- pop |>
  define_phenotype("WW2",
    type         = "continuous",
    mean         = 230,
    residual_var = 180,
    formula_tbv  = "WWD + dam(WWM)")

# ── SGE (social genetic effects): ADG = direct (self) + social group sum ──
pop <- pop |>
  define_phenotype("ADG_sge",
    type         = "continuous",
    mean         = 850,
    residual_var = 100,
    formula_tbv  = "ADG_direct + group_sum(ADG_social, pen_id)")

# ── Derived formula: FCR computed from already-recorded ADFI and ADG ────
# (Define ADFI and ADG first, then derive FCR — no TBV or residual needed)
pop <- pop |>
  define_phenotype("FCR",
    type    = "derived_formula",
    formula = "ADFI / ADG")
}
}
